# standalone.mk -- build the celldiag pieces that do NOT need ./configure
#
#   make -f standalone.mk               # = check-native, the default goal
#   make -f standalone.mk check-native  # the NATIVE=1 helper -> build-native/, and
#                                       #   its tests: the build that ships
#   make -f standalone.mk check         # every framework-free selftest
#   make -f standalone.mk baseline      # dev/test: the Python-decode helper ->
#                                       #   build-baseline/ (the oracle's build)
#   make -f standalone.mk deps          # dev/test: fetch the pinned decoder
#   make -f standalone.mk clean
#
# WHY THIS FILE EXISTS
# --------------------
# The celldiag parity checks (test_celldiag_replay_ab.py,
# test_celldiag_logstream_parity.py, celldiag_parity_status.py) define whether
# this tree's C decode path agrees with diaggrok. The top-level autoconf
# `./configure` hard-fails without libwebsockets >= 3.1.0, so on a host lacking
# that system library those checks would have no way to build what they test.
#
# Makefile.in cannot serve this purpose: it is rendered by the top-level
# config.status and its first line is `include ../Makefile.inc`, which is itself
# generated by configure. This file takes no autoconf input at all.
#
# WHAT `baseline` BUILDS
# --------------------
# `baseline` builds kismet_cap_cell_diag -- the Python-decode baseline helper --
# with NO autoconf input, reaching into NO ../diagspec/. It builds on Linux and
# Darwin, with or without libwebsockets. The shared config lives in
# baseline_platform.mk (capture_cell_at's `baseline` includes the same file).
#
# Two facts make that possible:
#
#   1. Every lws include, `struct lws_*` member and call site in
#      capture_framework.{c,h} is under `#ifdef HAVE_LIBWEBSOCKETS`, so the
#      helper needs libwebsockets only when the config enables it.
#
#   2. Nothing in the helper is structurally Linux-only. With a config.h naming
#      the actual OS (rather than asserting `#define SYS_LINUX 1` everywhere,
#      which pulls in <linux/sched.h>), Darwin links against libSystem alone.
#
# The generated config.h must therefore state only what is true of the host.
#
# What it still needs from the system: a C compiler. libwebsockets is used when
# present (LWS=auto), and libcap only when a copied ../config.h enables
# HAVE_CAPABILITY. A no-lws build loses only the remote-capture websocket
# transport, which no parity test uses; the build output says which you got.

# The default goal is the shipping build's gate, check-native. Named here because the first rule make reads is
# `baseline:` below, which would otherwise be the default; `baseline`, `check`
# and `deps` stay as explicit dev/test targets.
.DEFAULT_GOAL := check-native

CC      ?= cc
CFLAGS  ?= -Wall -g -O2
# No CXX / CXXFLAGS / DIAGSPEC_INC for the baseline, deliberately. Everything
# the `baseline` helper is built from is C, and an -I into ../diagspec/ is
# exactly the dependency that target exists to not have. The native half of this
# file (check-native, below) needs both, so every variable it uses is
# NATIVE_-prefixed and only its own recipes name them. A baseline recipe that
# picked one up would link decode legs, and the baseline's post-link symbol
# guard (role `baseline`: every leg ABSENT) fails exactly that link.

# The parity harness driver. diag_logstream.c + diag_hdlc.c and libc, nothing else.
LOGSTREAM_DUMP_BIN = diag_logstream_dump

# Every selftest in this directory that needs no capture framework.
TESTS = \
	test_diag_hdlc \
	test_diag_config \
	test_diag_capture \
	test_diag_rawlog \
	test_diag_capmeta \
	test_diag_clockanchor \
	test_diag_rawpkt \
	test_diag_optset \
	test_diag_stats \
	test_diag_profile \
	test_diag_portdiag \
	test_diag_ifclass \
	test_diag_wwanport \
	test_diag_probeclose \
	test_diag_modemident \
	test_diag_portadmit \
	test_diag_identvouch \
	test_diag_logstream \
	test_diag_bridgeq \
	test_diag_inventory \
	test_diag_gpsfix \
	test_diag_gsmtap_sink

# ===========================================================================
# baseline -- the Python-decode baseline helper, with no autoconf input
# ===========================================================================
BASELINE_DIR = build-baseline
# Not `kismet_cap_cell_diag` -- that is the generated Makefile's output path,
# and writing there would clobber a configured tree's helper. The failure is
# quiet: both builds exit 0, both are legitimately role `baseline` so both pass
# check_binary_symbols.sh, and .native_mode reads `baseline` either way, so
# nothing on disk tells you which makefile produced the binary. The symptom
# instead shows up as unrelated test failures (e.g. in argument handling) that
# point nowhere near the build system.
#
# celltools/Makefile's `replay-gate` target follows the same rule for the
# NATIVE=1/baseline pair -- "the two builds cannot coexist in the tree ... each
# binary is therefore copied out to $(GATE_DIR)". $(BASELINE_DIR) is ours alone
# and already .gitignore'd, so the check artifact lives there and the
# deliverable path has exactly one writer.
BASELINE_BIN = $(BASELINE_DIR)/kismet_cap_cell_diag

# The SAME pure-C modules Makefile.in's MONITOR_OBJS names, and the count is
# pinned for the SAME reason: a shorter list still builds, still links, and
# still passes every selftest while silently dropping a capability. Two lists in
# two files can drift, so the parity-discovery test in celltools/tests diffs
# this set against Makefile.in's.
BASELINE_CELLDIAG_SRCS = \
	capture_cell_diag.c \
	diag_hdlc.c \
	diag_config.c \
	diag_capture.c \
	diag_rawlog.c \
	diag_capmeta.c \
	diag_clockanchor.c \
	diag_rawpkt.c \
	diag_profile.c \
	diag_portdiag.c \
	diag_ifclass.c \
	diag_wwanport.c \
	diag_logstream.c \
	diag_stats.c \
	diag_optset.c \
	diag_probeclose.c \
	diag_modemident.c \
	diag_portadmit.c \
	diag_identvouch.c \
	diag_bridgeq.c \
	diag_inventory.c \
	diag_gpsfix.c \
	diag_gsmtap_sink.c
BASELINE_SRCS_COUNT = 23

# The extern "C" surface with nothing behind it. capture_cell_diag.c references
# diag_native_decode() at LINK scope regardless of the runtime nativedecode=
# branch, so the baseline needs the stub, not a shorter link line.
BASELINE_STUB_SRC = diag_native_decode_stub.c

# The capture framework -- what libkismetdatasource.a is, unpacked -- compiled
# from source so the target needs no prior top-level build. Its headers are
# listed too, as PREREQUISITES: the parity gauge's staleness guard
# (celltools/celldiag_parity.py, link_dependencies) derives a build-baseline/
# binary's closure from THIS rule, and a closure without the framework reads
# "current" after a framework edit. Mirrored in the sibling capture directory's
# standalone.mk; both sit one level below the tree root, so the paths agree.
BASELINE_KISMET_SRCS = \
	../capture_framework.c \
	../simple_ringbuf_c.c \
	../mpack/mpack.c
BASELINE_KISMET_HDRS = \
	../capture_framework.h \
	../simple_ringbuf_c.h \
	../mpack/mpack.h \
	../kis_external_packet.h \
	../kis_endian.h \
	../remote_announcement.h \
	../version.h


# -I$(BASELINE_DIR) FIRST so our generated config.h/version.c win; -I.. resolves
# ../capture_framework.h, ../mpack/mpack.h and friends.
#
# CELLDIAG_NATIVE_MODE is stated rather than left to capture_cell_diag.c's
# fallback: this target IS the baseline by construction (it has no NATIVE=1
# counterpart), so the value is known here and saying it keeps the two build
# systems agreeing out loud instead of by coincidence.
BASELINE_CFLAGS = -I$(BASELINE_DIR) -I.. -DCELLDIAG_NATIVE_MODE=\"baseline\" \
	$(BASELINE_LWS_CFLAGS) $(CFLAGS)

baseline: $(BASELINE_BIN)

# The fragment defines rules of its own. Which goal is the default no longer
# depends on this include's position: .DEFAULT_GOAL (top of file) names it.
include baseline_platform.mk

# The platform guard, config.h and version.c rules live in baseline_platform.mk.
# The guard refuses only an OS with no SYS_* mapping.
#
# NOTE: `check` is NOT the same claim as `baseline`. It builds no capture framework
# at all, so a green `check` says nothing about whether the helper links.

# baseline-platform-guard FIRST, so an unmapped OS gets an explanation instead
# of pages of clang output. It is listed on $(BASELINE_BIN) rather
# than on `baseline` because $(BASELINE_BIN) is the target that actually invokes
# the compiler -- a guard on the phony alias alone would be bypassed by anyone
# naming the binary path directly.
$(BASELINE_BIN): baseline-platform-guard \
		$(BASELINE_DIR)/config.h $(BASELINE_DIR)/version.c \
		$(BASELINE_CELLDIAG_SRCS) $(BASELINE_STUB_SRC) \
		$(BASELINE_KISMET_SRCS) $(BASELINE_KISMET_HDRS)
	@[ "$(words $(BASELINE_CELLDIAG_SRCS))" = "$(BASELINE_SRCS_COUNT)" ] || { \
	    echo "*** ERROR: BASELINE_CELLDIAG_SRCS has $(words $(BASELINE_CELLDIAG_SRCS)) sources, expected $(BASELINE_SRCS_COUNT) ***" >&2; \
	    echo "A pure-C module was added or LOST.  A shorter list still links and" >&2; \
	    echo "still passes check -- diag_logstream is what the logstream parity" >&2; \
	    echo "check runs on." >&2; \
	    exit 1; }
	$(CC) $(BASELINE_CFLAGS) -o $@ \
	    $(BASELINE_CELLDIAG_SRCS) $(BASELINE_STUB_SRC) \
	    $(BASELINE_KISMET_SRCS) $(BASELINE_DIR)/version.c \
	    -lpthread -lm $(BASELINE_CONFIG_LIBS)
	@echo "PASS: baseline $(BASELINE_BIN) built with no autoconf input"
	@echo "      (a CHECK artifact -- the tree's ./kismet_cap_cell_diag is untouched)"
# The same post-link polarity assertion the autoconf baseline link runs, when a
# ../diagspec/ directory is present to supply it. Absent, this target is still a
# legitimate build -- the whole point is that it works on a tree that has no
# ../diagspec/ at all -- so its absence SKIPS rather than fails, and says so.
	@if [ -f ../diagspec/check_binary_symbols.sh ]; then \
	    sh ../diagspec/check_binary_symbols.sh baseline $(BASELINE_BIN) ..; \
	else \
	    echo "  (symbol guard skipped: no ../diagspec/ in this tree)"; \
	fi

# ===========================================================================
# check-native -- the NATIVE=1 helper, with no autoconf input
# ===========================================================================
# `baseline` proves that the PYTHON-decode helper builds without ./configure.
# That is not what ships now that nativedecode=only is the default: the
# shipping binary is the NATIVE=1 link, with the C++ decode legs in it
# and no helper process. This target builds THAT binary the same
# dependency-free way and runs its tests, so a stranger build proves the
# configuration that actually ships. It is this file's default goal; `baseline`
# and `deps` stay as explicit dev/test targets.
#
# What it needs beyond `baseline`. Each is checked BEFORE anything compiles,
# and a missing one stops the build with a message naming the fix, never with
# a compiler error pages into the build:
#   a C++ compiler   $(NATIVE_CXX) (default: $(CXX)), at -std=gnu++20 with a C++
#                    standard library: the flags Kismet's own build compiles the
#                    legs with (see ../diagspec/README.md)
#   Kaitai runtime   $(NATIVE_KAITAI)/kaitaistream.cc and its kaitai/ headers,
#                    vendored at the tree root
#   decode sources   $(NATIVE_DIAGSPEC)/generated/cpp + enrichment/cpp, and the
#                    post-link symbol guard that sits beside them
# NATIVE_DIAGSPEC and NATIVE_KAITAI are overridable so a negative control can
# point one at nothing. A real build reads the tree's own copies.
#
# What it checks, in order:
#   1. the link, then the `helper`-role symbol guard: every leg the shim
#      declares is DEFINED in this binary. That is the mirror of `baseline`'s
#      legs-ABSENT assertion.
#   2. celldiag_binary_mode.sh reads the binary as `native`. That is the reading
#      the install guard (install-mode-guard, below) takes of an installed build.
#   3. the native-decode selftest, linked from the SAME objects;
#   4. the replay driver's own selftest;
#   5. the binary decodes the tree's own capture (fixtures/functional.hdlc) with
#      nativedecode=only, which starts no helper process and no python3, into
#      exactly $(NATIVE_FUNCTIONAL_EXPECTED). Those are the four observations
#      the Python bridge's fixtures/functional.expected.json pins;
#      capture_cell_diag/tests/test_functional_fixture.py holds the two files to
#      each other.
# It includes `check` (the framework-free selftests), so that at the flip the
# default goal is the whole native gate.
#
# Nothing in it runs python3. On a host with no interpreter at all, this target
# is the proof that the shipping configuration builds and decodes.
NATIVE_DIR      = build-native
NATIVE_OBJDIR   = $(NATIVE_DIR)/obj
# Not ./kismet_cap_cell_diag, for the reason BASELINE_BIN is not: that is the
# generated Makefile's output path, and a configured tree's helper must have
# exactly one writer.
NATIVE_BIN      = $(NATIVE_DIR)/kismet_cap_cell_diag
NATIVE_TEST_BIN = $(NATIVE_DIR)/test_diag_native_decode
NATIVE_REPLAY   = $(NATIVE_DIR)/celldiag_replay_ndjson

NATIVE_CXX      ?= $(CXX)
NATIVE_CXXFLAGS ?= -std=gnu++20 -g -O2
NATIVE_DIAGSPEC ?= ../diagspec
NATIVE_KAITAI   ?= ..

# The generated C++ decode closure: the SAME sources as Makefile.in's
# DIAGSPEC_SRCS, minus ../kaitaistream.cc (NATIVE_KAITAI_SRC below), with the
# count pinned for the same reason BASELINE_SRCS_COUNT is. Two lists in two files
# drift, so celltools/tests/test_celldiag_standalone_native.py diffs this one
# against Makefile.in's. A leg added there and not here also fails the link
# below: the shim calls it, and nothing defines it.
NATIVE_DIAGSPEC_SRCS = \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0x512f.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0x512f_observation.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb192.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb192_observation.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb195.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb195_observation.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0c0.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0c0_enrich.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0c0_observation.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0c0_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0e1.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0e1_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0e2.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0e2_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0e3.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0e3_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0ec.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0ec_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb0ed.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb0ed_gsmtap.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_nas_structure.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_rrc_sib.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_rrc_reconfig.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_rrc_meas_report.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_meas_join.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/asn1_helpers.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/uper.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb97f.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb97f_observation.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb193.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb193_observation.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb17f_observation.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_band.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/lte_cell_config.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0x1476.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0x1476_gpsfix.cpp \
	$(NATIVE_DIAGSPEC)/generated/cpp/diag_0xb821.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb821_enrich.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb821_identity.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/diag_0xb821_observation.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/nr5g_rrc.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/nr5g_rrc_meas_report.cpp \
	$(NATIVE_DIAGSPEC)/enrichment/cpp/nr_rrc_sib.cpp
NATIVE_DIAGSPEC_SRCS_COUNT = 44
NATIVE_GUARD       = $(NATIVE_DIAGSPEC)/check_binary_symbols.sh
NATIVE_KAITAI_SRC  = $(NATIVE_KAITAI)/kaitaistream.cc
NATIVE_KAITAI_HDRS = $(NATIVE_KAITAI)/kaitai/kaitaistream.h $(NATIVE_KAITAI)/kaitai/kaitaistruct.h

# The C half is the baseline's own module set and framework (not the stub), with
# the mode stated as `native`. It reuses $(BASELINE_DIR)'s generated config.h and
# version.c: neither depends on the decode mode, and one config per link holds
# across the two builds as well as within each.
NATIVE_CFLAGS   = -I$(BASELINE_DIR) -I.. -DCELLDIAG_NATIVE_MODE=\"native\" \
	$(BASELINE_LWS_CFLAGS) $(CFLAGS)
# KS_STR_ENCODING_NONE is the Kaitai string mode Kismet's own build compiles the
# runtime and the legs with. It is not a tuning knob: it decides which runtime
# code is compiled, so it is fixed here rather than left in NATIVE_CXXFLAGS.
NATIVE_CXXFLAGS_ALL = -I$(NATIVE_KAITAI) -I$(NATIVE_DIAGSPEC)/generated/cpp \
	-I$(NATIVE_DIAGSPEC)/enrichment/cpp -DKS_STR_ENCODING_NONE $(NATIVE_CXXFLAGS)

# One object per source, named by the source's basename and built from its real
# path. Static pattern rules, one per source directory, so no vpath search can
# resolve a name to the wrong directory or reach the rules above.
NATIVE_LOCAL_C_OBJS = $(patsubst %,$(NATIVE_OBJDIR)/%.o,$(BASELINE_CELLDIAG_SRCS))
NATIVE_FW_C_OBJS    = $(patsubst ../%,$(NATIVE_OBJDIR)/%.o,$(filter-out ../mpack/%,$(BASELINE_KISMET_SRCS)))
NATIVE_C_OBJS       = $(NATIVE_LOCAL_C_OBJS) $(NATIVE_FW_C_OBJS) \
	$(NATIVE_OBJDIR)/mpack.c.o $(NATIVE_OBJDIR)/version.c.o
NATIVE_GEN_OBJS     = $(patsubst $(NATIVE_DIAGSPEC)/generated/cpp/%,$(NATIVE_OBJDIR)/%.o,\
	$(filter $(NATIVE_DIAGSPEC)/generated/cpp/%,$(NATIVE_DIAGSPEC_SRCS)))
NATIVE_ENRICH_OBJS  = $(patsubst $(NATIVE_DIAGSPEC)/enrichment/cpp/%,$(NATIVE_OBJDIR)/%.o,\
	$(filter $(NATIVE_DIAGSPEC)/enrichment/cpp/%,$(NATIVE_DIAGSPEC_SRCS)))
NATIVE_CXX_OBJS     = $(NATIVE_OBJDIR)/diag_native_decode.cpp.o $(NATIVE_GEN_OBJS) \
	$(NATIVE_ENRICH_OBJS) $(NATIVE_OBJDIR)/kaitaistream.cc.o

# -MMD -MP: every object here is born with its depfile, so a header change
# (a diagspec sync) recompiles what includes it. Makefile.in cannot use -MMD,
# because its objects predate their depfiles (see its %.cpp.d rule); these
# cannot, because nothing but these rules writes $(NATIVE_OBJDIR).
NATIVE_COMPILE_C   = $(CC) $(NATIVE_CFLAGS) -MMD -MP -c $< -o $@
NATIVE_COMPILE_CXX = $(NATIVE_CXX) $(NATIVE_CXXFLAGS_ALL) -MMD -MP -c $< -o $@

# The prerequisites, decided when this file is read. A missing source would
# otherwise surface as make's "No rule to make target", or a missing compiler
# as "g++: No such file or directory", neither of which names the fix.
NATIVE_CXX_FOUND        := $(shell command -v $(firstword $(NATIVE_CXX)) 2>/dev/null)
NATIVE_MISSING_DIAGSPEC := $(strip $(foreach f,$(NATIVE_DIAGSPEC_SRCS) $(NATIVE_GUARD),$(if $(wildcard $(f)),,$(f))))
NATIVE_MISSING_KAITAI   := $(strip $(foreach f,$(NATIVE_KAITAI_SRC) $(NATIVE_KAITAI_HDRS),$(if $(wildcard $(f)),,$(f))))
NATIVE_PREREQ_PROBLEMS  := $(strip $(if $(NATIVE_CXX_FOUND),,cxx) \
	$(if $(NATIVE_MISSING_KAITAI),kaitai) $(if $(NATIVE_MISSING_DIAGSPEC),diagspec))

# The guard every native object waits on (order-only, so it never forces a
# rebuild). With a prerequisite missing it is the ONLY thing the native targets
# run, and it fails with the list. Otherwise it also proves the compiler can
# build C++ at these flags with a standard library: a compiler present on PATH
# with no libstdc++ headers fails here, on a five-line probe, not on a leg.
native-prereqs: baseline-platform-guard
ifneq ($(NATIVE_PREREQ_PROBLEMS),)
	@echo "*** check-native: the NATIVE=1 build cannot start; a prerequisite is missing:" >&2
ifneq ($(filter cxx,$(NATIVE_PREREQ_PROBLEMS)),)
	@echo "***   C++ compiler: '$(NATIVE_CXX)' is not on PATH. Install one (Debian/Ubuntu: g++," >&2
	@echo "***     Fedora: gcc-c++, Alpine: g++), or name it: CXX=<compiler>." >&2
endif
ifneq ($(filter kaitai,$(NATIVE_PREREQ_PROBLEMS)),)
	@echo "***   Kaitai runtime: not found under NATIVE_KAITAI=$(NATIVE_KAITAI) -- missing" >&2
	@echo "***     $(NATIVE_MISSING_KAITAI)" >&2
	@echo "***     The tree vendors it at its root (kaitaistream.cc, kaitai/)." >&2
endif
ifneq ($(filter diagspec,$(NATIVE_PREREQ_PROBLEMS)),)
	@echo "***   decode sources: $(words $(NATIVE_MISSING_DIAGSPEC)) file(s) missing under NATIVE_DIAGSPEC=$(NATIVE_DIAGSPEC), e.g." >&2
	@echo "***     $(wordlist 1,3,$(NATIVE_MISSING_DIAGSPEC))" >&2
	@echo "***     The native legs are compiled from the tree's diagspec/ (generated/cpp, enrichment/cpp)." >&2
endif
	@echo "*** (\`make -f standalone.mk baseline\` builds the dev/test Python-decode helper without any" >&2
	@echo "***  of these, but that is not the build that ships: its sources must say nativedecode=off.)" >&2
	@exit 1
else
	@mkdir -p $(NATIVE_OBJDIR)
	@printf '#include <memory>\n#include <string>\nint main() { auto s = std::make_unique<std::string>("x"); return (int)s->size() - 1; }\n' > $(NATIVE_DIR)/cxx-probe.cpp
	@$(NATIVE_CXX) $(NATIVE_CXXFLAGS) -o $(NATIVE_DIR)/cxx-probe $(NATIVE_DIR)/cxx-probe.cpp > $(NATIVE_DIR)/cxx-probe.log 2>&1 || { \
	    echo "*** check-native: '$(NATIVE_CXX)' ($(NATIVE_CXX_FOUND)) is on PATH but cannot build C++ at" >&2; \
	    echo "*** NATIVE_CXXFLAGS='$(NATIVE_CXXFLAGS)': no C++ standard library, or too old for gnu++20." >&2; \
	    sed 's/^/***   /' $(NATIVE_DIR)/cxx-probe.log >&2; \
	    exit 1; }
	@echo "  native prerequisites: C++ $(NATIVE_CXX_FOUND), Kaitai runtime in $(NATIVE_KAITAI), decode sources in $(NATIVE_DIAGSPEC)"
endif

# Rewritten only when the flags change, so an object compiled under other flags
# is rebuilt and an unchanged one is not -- the .native_mode idiom, for flags.
NATIVE_FLAGS_TEXT = C: $(CC) $(NATIVE_CFLAGS) | C++: $(NATIVE_CXX) $(NATIVE_CXXFLAGS_ALL)
$(NATIVE_DIR)/flags: native-flags-force | native-prereqs
	@printf '%s\n' '$(NATIVE_FLAGS_TEXT)' > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; echo "  native flags -> $(NATIVE_FLAGS_TEXT)"; fi

# The same idiom for the LINK: a changed object list (a leg added to, dropped
# from or swapped in NATIVE_DIAGSPEC_SRCS) changes no object's timestamp, so
# without this the old binary reads current and every check below runs against
# a link that no longer matches this file. The mutation pass found exactly that.
NATIVE_LINK_TEXT = $(NATIVE_CXX) $(LDFLAGS) | $(NATIVE_C_OBJS) $(NATIVE_CXX_OBJS)
$(NATIVE_DIR)/link: native-flags-force | native-prereqs
	@printf '%s\n' '$(NATIVE_LINK_TEXT)' > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; echo "  native link inputs changed"; fi

$(NATIVE_LOCAL_C_OBJS): $(NATIVE_OBJDIR)/%.o: % $(BASELINE_DIR)/config.h $(NATIVE_DIR)/flags | native-prereqs
	$(NATIVE_COMPILE_C)
$(NATIVE_FW_C_OBJS): $(NATIVE_OBJDIR)/%.o: ../% $(BASELINE_DIR)/config.h $(NATIVE_DIR)/flags | native-prereqs
	$(NATIVE_COMPILE_C)
$(NATIVE_OBJDIR)/mpack.c.o: ../mpack/mpack.c $(BASELINE_DIR)/config.h $(NATIVE_DIR)/flags | native-prereqs
	$(NATIVE_COMPILE_C)
